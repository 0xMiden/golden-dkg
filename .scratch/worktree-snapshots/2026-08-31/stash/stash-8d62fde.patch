@@ -0,0 +1,83 @@
+//! Fixed two-dealing verifier comparison for the Secp256k1/Secq256k1 backend.
+//!
+//! The harness precomputes two independent one-dealing proofs and one joint
+//! two-dealing proof, then times sequential independent verification,
+//! cross-proof verification batching, and joint-proof verification.
+
+#![allow(non_snake_case)]
+#![allow(missing_docs)]
+#![allow(clippy::unwrap_used)]
+
+#[path = "two_dealing_support/mod.rs"]
+mod support;
+
+use codspeed_criterion_compat as criterion;
+use criterion::{black_box, criterion_group, criterion_main, BatchSize, Criterion, SamplingMode};
+use golden_evrf::paper::secp_secq::{evrf_batched_verify, evrf_batched_verify_many};
+use support::{prove_comparison, rng_for, SLOW_SAMPLE_SIZE};
+
+fn evrf_verify_comparison(c: &mut Criterion) {
+    let comparison = prove_comparison();
+    let first = &comparison.independent[0];
+    let second = &comparison.independent[1];
+    let joint = &comparison.joint;
+
+    let mut group = c.benchmark_group("paper-evrf/two-dealing/verify");
+    group.sample_size(SLOW_SAMPLE_SIZE);
+    group.sampling_mode(SamplingMode::Flat);
+
+    group.bench_function("two-independent/sequential", |b| {
+        b.iter_batched(
+            || (rng_for(21), rng_for(22)),
+            |(mut first_rng, mut second_rng)| {
+                evrf_batched_verify(
+                    &first.params,
+                    &first.statement,
+                    &first.proof,
+                    &mut first_rng,
+                )
+                .unwrap();
+                evrf_batched_verify(
+                    &second.params,
+                    &second.statement,
+                    &second.proof,
+                    &mut second_rng,
+                )
+                .unwrap();
+                black_box(());
+            },
+            BatchSize::SmallInput,
+        )
+    });
+
+    group.bench_function("two-independent/cross-proof-batch", |b| {
+        b.iter(|| {
+            evrf_batched_verify_many(
+                &first.params,
+                &[
+                    (&first.statement, first.proof.as_slice()),
+                    (&second.statement, second.proof.as_slice()),
+                ],
+            )
+            .unwrap();
+            black_box(());
+        })
+    });
+
+    group.bench_function("one-joint/two-dealings", |b| {
+        b.iter_batched(
+            || rng_for(23),
+            |mut rng| {
+                evrf_batched_verify(&joint.params, &joint.statement, &joint.proof, &mut rng)
+                    .unwrap();
+                black_box(());
+            },
+            BatchSize::SmallInput,
+        )
+    });
+
+    group.finish();
+}
+
+criterion_group!(benches, evrf_verify_comparison);
+criterion_main!(benches);
diff --git a/crates/golden-evrf/benches/two_dealing_support/mod.rs b/crates/golden-evrf/benches/two_dealing_support/mod.rs
new file mode 100644
index 0000000..aa4aa92
--- /dev/null
+++ b/crates/golden-evrf/benches/two_dealing_support/mod.rs
@@ -0,0 +1,229 @@
+//! Shared fixed-shape harness for the two-dealing paper eVRF and DKG benchmarks.
+//!
+//! The comparison is intentionally narrow: threshold 2, three participants,
+//! two non-dealer receivers, and exactly two dealings. It contrasts two
+//! independent one-dealing proofs with one joint two-dealing proof and drives
+//! the public batch-native DKG surface for an ordered `[Random, Zero]` setup.
+
+#![allow(non_snake_case)]
+#![allow(missing_docs)]
+#![allow(dead_code)]
+#![allow(clippy::unwrap_used)]
+#![allow(clippy::type_complexity)]
+
+use std::{collections::BTreeMap, sync::Arc};
+
+use golden_core::{
+    complete, create_dealing, DkgBatchOutput, DkgConfig, DkgDealing, DkgKind, GoldenGroup,
+    GoldenScalar, ParticipantIndex, ParticipantRegistry, SessionId,
+};
+use golden_evrf::paper::secp_secq::SecpSecqBackend;
+use golden_evrf::paper::secp_secq::{
+    evrf_batched_prove, evrf_batched_verify, testing, BatchedEvrfPublicParams,
+    BatchedEvrfStatement, BatchedEvrfWitness, Gin, GinScalar, R1csField,
+};
+use golden_evrf::paper::MESSAGE_BYTES;
+use golden_halo2curves::golden_group::{Secp256k1GoldenGroup, Secp256k1Scalar};
+use rand_chacha::{rand_core::SeedableRng, ChaCha20Rng};
+
+pub const THRESHOLD: usize = 2;
+pub const PARTICIPANT_COUNT: usize = 3;
+pub const RECEIVER_COUNT: usize = PARTICIPANT_COUNT - 1;
+pub const SLOW_SAMPLE_SIZE: usize = 10;
+pub const BENCH_SEED: [u8; 32] = [7u8; 32];
+
+#[derive(Clone)]
+pub struct RelationFixture {
+    pub statement: BatchedEvrfStatement,
+    pub witness: BatchedEvrfWitness,
+}
+
+pub struct ProvedRelation {
+    pub params: Arc<BatchedEvrfPublicParams>,
+    pub statement: BatchedEvrfStatement,
+    pub proof: Vec<u8>,
+}
+
+pub struct ProvedComparison {
+    pub independent: Vec<ProvedRelation>,
+    pub joint: ProvedRelation,
+}
+
+pub fn idx(value: u32) -> ParticipantIndex {
+    ParticipantIndex::new(value).unwrap()
+}
+
+pub fn identity_secret(participant: ParticipantIndex) -> Secp256k1Scalar {
+    Secp256k1Scalar::from_u64(100 + u64::from(participant.get())).unwrap()
+}
+
+fn registry() -> ParticipantRegistry<Secp256k1GoldenGroup> {
+    ParticipantRegistry::new(
+        (1..=PARTICIPANT_COUNT as u32)
+            .map(idx)
+            .map(|participant| {
+                (
+                    participant,
+                    Secp256k1GoldenGroup::mul_generator(&identity_secret(participant)),
+                )
+            })
+            .collect(),
+    )
+    .unwrap()
+}
+
+pub fn batch_config() -> DkgConfig<Secp256k1GoldenGroup> {
+    DkgConfig::batch(
+        THRESHOLD,
+        SessionId([42u8; 32]),
+        Secp256k1Scalar::from_u64(77).unwrap(),
+        registry(),
+        vec![DkgKind::Random, DkgKind::Zero],
+    )
+    .unwrap()
+}
+
+fn message(seed: u64) -> [u8; MESSAGE_BYTES] {
+    let mut message = [0u8; MESSAGE_BYTES];
+    message[..8].copy_from_slice(&seed.to_le_bytes());
+    message
+}
+
+fn receiver_public_keys() -> Vec<Gin> {
+    (0..RECEIVER_COUNT)
+        .map(|receiver| Gin::generator() * GinScalar::from(1_000 + receiver as u64))
+        .collect()
+}
+
+pub fn independent_relations() -> Vec<RelationFixture> {
+    let joint = joint_relation();
+    joint
+        .statement
+        .dealings
+        .iter()
+        .zip(&joint.witness.dealings)
+        .map(|(dealing, dealing_witness)| RelationFixture {
+            statement: BatchedEvrfStatement {
+                pk1: joint.statement.pk1,
+                beta: joint.statement.beta,
+                threshold: joint.statement.threshold,
+                dealings: vec![dealing.clone()],
+            },
+            witness: BatchedEvrfWitness {
+                sk1: joint.witness.sk1,
+                dealings: vec![dealing_witness.clone()],
+            },
+        })
+        .collect()
+}
+
+pub fn joint_relation() -> RelationFixture {
+    let sk1 = GinScalar::from(7u64);
+    let beta = R1csField::from(77u64);
+    let receiver_public_keys = receiver_public_keys();
+    let messages = [message(0xA0), message(0xB0)];
+    let constants = [GinScalar::from(10u64), GinScalar::from(0u64)];
+    let (statement, witness) = testing::build_batched_dealings_with_constants(
+        &messages,
+        &constants,
+        sk1,
+        &receiver_public_keys,
+        beta,
+    );
+    RelationFixture { statement, witness }
+}
+
+pub fn params_for(statement: &BatchedEvrfStatement) -> Arc<BatchedEvrfPublicParams> {
+    BatchedEvrfPublicParams::shared(
+        statement.threshold,
+        statement.receiver_count(),
+        statement.dealing_count(),
+    )
+    .expect("valid public parameter shape")
+}
+
+pub fn rng_for(tag: u8) -> ChaCha20Rng {
+    let mut seed = BENCH_SEED;
+    seed[0] ^= tag;
+    ChaCha20Rng::from_seed(seed)
+}
+
+pub fn prove_comparison() -> ProvedComparison {
+    let independent = independent_relations()
+        .into_iter()
+        .enumerate()
+        .map(|(index, fixture)| {
+            let params = params_for(&fixture.statement);
+            let mut rng = rng_for(u8::try_from(index + 1).unwrap());
+            let proof = evrf_batched_prove(&params, &fixture.statement, &fixture.witness, &mut rng)
+                .unwrap();
+            let mut verify_rng = rng_for(u8::try_from(index + 11).unwrap());
+            evrf_batched_verify(&params, &fixture.statement, &proof, &mut verify_rng).unwrap();
+            ProvedRelation {
+                params,
+                statement: fixture.statement,
+                proof,
+            }
+        })
+        .collect();
+
+    let fixture = joint_relation();
+    let params = params_for(&fixture.statement);
+    let mut rng = rng_for(3);
+    let proof =
+        evrf_batched_prove(&params, &fixture.statement, &fixture.witness, &mut rng).unwrap();
+    let mut verify_rng = rng_for(13);
+    evrf_batched_verify(&params, &fixture.statement, &proof, &mut verify_rng).unwrap();
+    let joint = ProvedRelation {
+        params,
+        statement: fixture.statement,
+        proof,
+    };
+
+    ProvedComparison { independent, joint }
+}
+
+pub fn create_dealer_batch(
+    config: &DkgConfig<Secp256k1GoldenGroup>,
+    dealer: ParticipantIndex,
+    rng: &mut ChaCha20Rng,
+) -> DkgDealing<Secp256k1GoldenGroup> {
+    create_dealing::<Secp256k1GoldenGroup, SecpSecqBackend>(
+        dealer,
+        &identity_secret(dealer),
+        config,
+        rng,
+    )
+    .unwrap()
+}
+
+pub fn complete_joint_dkg(rng: &mut ChaCha20Rng) -> Vec<DkgBatchOutput<Secp256k1GoldenGroup>> {
+    let config = batch_config();
+    let dealings: BTreeMap<ParticipantIndex, DkgDealing<Secp256k1GoldenGroup>> = config
+        .registry
+        .indexes()
+        .map(|dealer| (dealer, create_dealer_batch(&config, dealer, rng)))
+        .collect();
+
+    config
+        .registry
+        .indexes()
+        .map(|receiver| {
+            let own_dealing = dealings.get(&receiver).unwrap();
+            let peer_dealings = dealings
+                .iter()
+                .filter_map(|(dealer, dealing)| {
+                    (*dealer != receiver).then_some((*dealer, dealing.message.clone()))
+                })
+                .collect();
+            complete::<Secp256k1GoldenGroup, SecpSecqBackend>(
+                receiver,
+                &identity_secret(receiver),
+                own_dealing,
+                &peer_dealings,
+                &config,
+            )
+            .unwrap()
+        })
+        .collect()
+}
