+//! Fixed two-dealing prover comparison for the Secp256k1/Secq256k1 backend.
+//!
+//! Benchmarks exactly three cases:
+//! - two independent one-dealing proofs produced sequentially;
+//! - the same two independent proofs produced concurrently with `rayon::join`,
+//!   sharing the exact process-wide worker budget used by the sequential case;
+//! - one joint proof over both ordered dealings.
+//!
+//! Statement/witness construction and warm parameter lookup stay outside each
+//! timed region. No benchmark results are recorded in source.
+
+#![allow(non_snake_case)]
+#![allow(missing_docs)]
+#![allow(clippy::unwrap_used)]
+
+#[path = "two_dealing_support/mod.rs"]
+mod support;
+
+use codspeed_criterion_compat as criterion;
+use criterion::{black_box, criterion_group, criterion_main, BatchSize, Criterion, SamplingMode};
+use golden_evrf::paper::secp_secq::evrf_batched_prove;
+use p3_maybe_rayon::prelude::{current_num_threads, join};
+use support::{independent_relations, joint_relation, params_for, rng_for, SLOW_SAMPLE_SIZE};
+
+fn evrf_prove_comparison(c: &mut Criterion) {
+    let mut group = c.benchmark_group("paper-evrf/two-dealing/prove");
+    group.sample_size(SLOW_SAMPLE_SIZE);
+    group.sampling_mode(SamplingMode::Flat);
+
+    let independent = independent_relations();
+    let independent_params = params_for(&independent[0].statement);
+    eprintln!(
+        "two-dealing prover comparison: shared_rayon_worker_threads={}",
+        current_num_threads()
+    );
+    group.bench_function("two-independent/sequential", |b| {
+        b.iter_batched(
+            || independent.clone(),
+            |fixtures| {
+                let mut first_rng = rng_for(1);
+                let first = evrf_batched_prove(
+                    &independent_params,
+                    &fixtures[0].statement,
+                    &fixtures[0].witness,
+                    &mut first_rng,
+                )
+                .unwrap();
+                let mut second_rng = rng_for(2);
+                let second = evrf_batched_prove(
+                    &independent_params,
+                    &fixtures[1].statement,
+                    &fixtures[1].witness,
+                    &mut second_rng,
+                )
+                .unwrap();
+                black_box((first, second));
+            },
+            BatchSize::SmallInput,
+        )
+    });
+
+    group.bench_function("two-independent/concurrent-fixed-worker-budget", |b| {
+        b.iter_batched(
+            || independent.clone(),
+            |fixtures| {
+                let (first, second) = join(
+                    || {
+                        let mut rng = rng_for(1);
+                        evrf_batched_prove(
+                            &independent_params,
+                            &fixtures[0].statement,
+                            &fixtures[0].witness,
+                            &mut rng,
+                        )
+                        .unwrap()
+                    },
+                    || {
+                        let mut rng = rng_for(2);
+                        evrf_batched_prove(
+                            &independent_params,
+                            &fixtures[1].statement,
+                            &fixtures[1].witness,
+                            &mut rng,
+                        )
+                        .unwrap()
+                    },
+                );
+                black_box((first, second));
+            },
+            BatchSize::SmallInput,
+        )
+    });
+
+    let joint = joint_relation();
+    let joint_params = params_for(&joint.statement);
+    group.bench_function("one-joint/two-dealings", |b| {
+        b.iter_batched(
+            || joint.clone(),
+            |fixture| {
+                let mut rng = rng_for(3);
+                let proof = evrf_batched_prove(
+                    &joint_params,
+                    &fixture.statement,
+                    &fixture.witness,
+                    &mut rng,
+                )
+                .unwrap();
+                black_box(proof);
+            },
+            BatchSize::SmallInput,
+        )
+    });
+
+    group.finish();
+}
+
+criterion_group!(benches, evrf_prove_comparison);
+criterion_main!(benches);
