+//! End-to-end completed `[Random, Zero]` DKG setup benchmark.
+//!
+//! Each timed iteration creates one joint two-dealing `DealerBatch` for every
+//! participant and calls `complete` for every participant, yielding ordered
+//! `DkgBatchOutput::instances`. This is the full batch-native setup path rather
+//! than isolated legacy rounds.
+
+#![allow(non_snake_case)]
+#![allow(missing_docs)]
+#![allow(clippy::unwrap_used)]
+
+#[path = "two_dealing_support/mod.rs"]
+mod support;
+
+use codspeed_criterion_compat as criterion;
+use criterion::{black_box, criterion_group, criterion_main, BatchSize, Criterion, SamplingMode};
+use support::{complete_joint_dkg, rng_for, SLOW_SAMPLE_SIZE};
+
+fn completed_random_zero_dkg(c: &mut Criterion) {
+    let mut group = c.benchmark_group("golden-dkg/two-dealing/full-random-zero-setup");
+    group.sample_size(SLOW_SAMPLE_SIZE);
+    group.sampling_mode(SamplingMode::Flat);
+    group.bench_function("all-dealers/all-participants-complete", |b| {
+        b.iter_batched(
+            || rng_for(41),
+            |mut rng| {
+                let outputs = complete_joint_dkg(&mut rng);
+                black_box(outputs);
+            },
+            BatchSize::SmallInput,
+        )
+    });
+    group.finish();
+}
+
+criterion_group!(benches, completed_random_zero_dkg);
+criterion_main!(benches);
